# scout_daemon environment
#
# Copy to `.env`. Shell vars win over anything set here (override=False).
#
# NO SOURCE CREDENTIALS APPEAR IN THIS FILE, AND NONE SHOULD EVER BE ADDED.
# Every WIRE surface was selected during SC-R1 for readability without auth.
# The scout never creates an account and never authenticates to a source --
# if a surface ever needs a credential, that is a Treasurer decision and a
# different daemon's job, not a line in this file.

# Required only at the classification pass, never at spine startup.
ANTHROPIC_API_KEY=

# The file form (~/.openclaw/scout/HALT) works independently and needs no shell.
SCOUT_HALT=